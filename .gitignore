# Generated runtime state and caches
.config/Mesen2/*.lock
.config/mozilla/firefox/Crash Reports/*.log
.config/session/
.debuginfod.sqlite*
.zcompdump*

# Python installer tooling
__pycache__/
*.py[cod]

# Generated npm launcher
.local/bin/codex

# Local application data and generated telemetry
.config/Mesen2/
.config/go/telemetry/
