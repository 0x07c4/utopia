{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utopia.local/schemas/features.schema.json",
  "title": "Utopia host-scoped feature deployment definitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "features"],
  "properties": {
    "schema_version": { "const": 1 },
    "features": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/feature" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "state_path",
        "domain",
        "activation_state",
        "required_artifacts",
        "template_source",
        "hook_source",
        "generated_directory",
        "generated_theme",
        "selector_destination",
        "opt_in_destination",
        "fallback_theme",
        "dynamic_theme",
        "backup_destinations",
        "rollback_destinations",
        "reload"
      ],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "state_path": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$" },
        "domain": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "activation_state": { "type": "string", "enum": ["experimental", "managed"] },
        "required_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" }
        },
        "template_source": { "$ref": "#/$defs/relativePath" },
        "hook_source": { "$ref": "#/$defs/relativePath" },
        "generated_directory": { "$ref": "#/$defs/relativePath" },
        "generated_theme": { "$ref": "#/$defs/relativePath" },
        "selector_destination": { "$ref": "#/$defs/relativePath" },
        "opt_in_destination": { "$ref": "#/$defs/relativePath" },
        "fallback_theme": { "type": "string", "minLength": 1 },
        "dynamic_theme": { "type": "string", "minLength": 1 },
        "backup_destinations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "rollback_destinations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "reload": { "$ref": "#/$defs/reload" }
      }
    },
    "reload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bus_name", "object_path", "interface", "method", "argument"],
      "properties": {
        "bus_name": { "type": "string", "minLength": 1 },
        "object_path": { "type": "string", "pattern": "^/[^ ]*$" },
        "interface": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "argument": { "type": "string", "minLength": 1 }
      }
    }
  }
}
