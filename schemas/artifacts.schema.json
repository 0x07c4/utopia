{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utopia.local/schemas/artifacts.schema.json",
  "title": "Utopia home artifact catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "(^|/)\\.\\.(/|$)" },
          { "const": "." }
        ]
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer",
        "domain",
        "source",
        "destination",
        "kind",
        "state",
        "capture",
        "deploy",
        "validators"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "layer": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "source": { "$ref": "#/$defs/relativePath" },
        "destination": { "$ref": "#/$defs/relativePath" },
        "kind": { "enum": ["file", "tree", "gitlink"] },
        "state": { "enum": ["managed", "unmanaged", "experimental"] },
        "capture": { "type": "boolean" },
        "deploy": { "type": "boolean" },
        "validators": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "excludes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "mode": {
          "type": "string",
          "pattern": "^0[0-7]{3}$"
        },
        "replaces": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        }
      }
    }
  }
}
