    layout {
        gaps 16 // Gap between windows
        center-focused-column "never" // Don’t auto-center focused column

        background-color "transparent" // <- needed for noctalia-shell to set wallpaper

        // Deterministic fallback; Noctalia's optional include overrides these
        // colors after it has resolved the active wallpaper palette.
        focus-ring {
            active-color "#8caaee"
            inactive-color "#414559"
            urgent-color "#e78284"
        }

        tab-indicator {
            active-color "#8caaee"
            inactive-color "#414559"
            urgent-color "#e78284"
        }

        insert-hint {
            color "#8caaee80"
        }

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

        // Restored from Utopia: new tiled windows start at half the output width.
        default-column-width { proportion 0.5; }

        struts {}
    }
