#!/bin/sh
# Explicit desktop trial entry: no installation or prefix creation here.
set -eu

fail() {
    printf '%s\n' "$1" >&2
    if command -v notify-send >/dev/null 2>&1; then
        notify-send '战网（国服）' "$1" || :
    fi
    exit 1
}

case "${1-}" in
    --help) printf '%s\n' 'Usage: utopia-battlenet-cn [--check]'; exit 0 ;;
    ''|--check) ;;
    *) fail '不支持的参数；使用 --check 检查现有安装。' ;;
esac
[ "$#" -le 1 ] || fail '不接受额外参数。'

data_root=${XDG_DATA_HOME:-"$HOME/.local/share"}
case "$data_root" in
    /*) ;;
    *) fail 'XDG_DATA_HOME 必须是绝对路径。' ;;
esac
WINEPREFIX="$data_root/utopia/gameprefixes/battlenet-cn-legacy"
runner="$data_root/lutris/runners/wine/wine-11.19-staging-amd64/bin/wine"
client="$WINEPREFIX/drive_c/Program Files (x86)/Battle.net/Battle.net.exe"
[ -f "$WINEPREFIX/system.reg" ] || fail '未找到已验证的国服战网前缀；请先完成独立安装。'
[ -x "$runner" ] || fail '未找到已验证的 Wine Staging 11.19 运行器。'
[ -f "$client" ] || fail '此独立前缀中尚未安装战网客户端。'
if [ "${1-}" = --check ]; then
    printf '%s\n' '战网前缀、运行器和客户端文件已就绪；此检查不启动 Wine。'
    exit 0
fi

# Battle.net's own single-instance handling does not reliably activate Niri.
# Focus only an unambiguous existing client; otherwise let Wine handle startup.
if [ -n "${NIRI_SOCKET-}" ] && command -v python3 >/dev/null 2>&1 &&
    command -v niri >/dev/null 2>&1; then
    if python3 - <<'PY'
import json
import subprocess
import sys

try:
    result = subprocess.run(["niri", "msg", "--json", "windows"],
                            capture_output=True, text=True, check=True, timeout=3)
    windows = [w for w in json.loads(result.stdout) if w.get("app_id") == "battle.net.exe"]
    if len(windows) != 1:
        sys.exit(1)
    subprocess.run(["niri", "msg", "action", "focus-window", "--id", str(windows[0]["id"])],
                   capture_output=True, check=True, timeout=3)
except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
    sys.exit(1)
PY
    then
        exit 0
    fi
fi

export WINEPREFIX
# Do not inherit another game's architecture or DLL override experiment.
unset WINEARCH WINEDLLOVERRIDES WINELOADER WINESERVER
export WINEDEBUG=-all
cd "${client%/*}"
exec "$runner" 'C:\Program Files (x86)\Battle.net\Battle.net.exe'
